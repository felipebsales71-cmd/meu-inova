{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meu-inova",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-10",

  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meu-inova-db",
      "database_id": "ffdbbbe8-760f-43fb-b312-49f020cfd34b"
    }
  ],

  "triggers": {
    "crons": ["0 12 * * *"]
  },

  "vars": {
    "APP_TIMEZONE": "America/Cuiaba",
    "RESET_TOKEN_MINUTES": "30",
    "SESSION_HOURS": "12",
    "MAIL_FROM": "Meu Inova <noreply@example.com>"
  }
}
